# Base de datos (te la da Railway/Supabase/Neon al crear el proyecto)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Genera uno largo y aleatorio, ej: openssl rand -hex 32
JWT_SECRET=

# API keys de tus proveedores SMM
BESTSMM_API_KEY=
SMMCPAN_API_KEY=

PORT=3000

# Viralizame IA (Claude API) — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Login con Google — console.cloud.google.com > APIs & Services > Clients
# (el mismo Client ID que usa el frontend en VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
